# Copy to .env only to run the model path. The rule baseline needs nothing at all.
# Any OpenAI-compatible endpoint works: ollama, llama.cpp, vLLM, a hosted API.
DECIDE_MODEL_URL=http://localhost:11434/v1
DECIDE_MODEL_NAME=qwen2.5:7b-instruct
DECIDE_MODEL_KEY=
# Confidence below which the service abstains rather than answering.
DECIDE_THRESHOLD=0.6
